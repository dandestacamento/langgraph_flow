# Copy to ../.env (repo root) if you haven't already - this project reads
# the shared repo-root .env, it does not use its own .env file.
OPENAI_API_KEY=sk-...

# Optional: override the model used by routers/agents (default: gpt-4o-mini)
# ROUTING_LAB_MODEL=gpt-4o-mini

# Optional: MLflow tracking server URL if not the default (see
# ../start_mlflow.ps1). Tracing is skipped automatically if unreachable.
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
