# Reverse-proxies /api/* to the FastAPI backend (app/api/main.py) in
# production - the same effect vite.config.ts's dev-only server.proxy
# gives locally, per instructions/learnings/chat-ui-plan1.md section
# 2.5. ${BACKEND_HOST}/${BACKEND_PORT} are substituted at container
# startup by nginx's own envsubst-on-templates mechanism (see the
# Dockerfile) - not baked in at build time, so no VITE_API_BASE_URL is
# ever needed: the frontend always calls same-origin "/api/...".

server {
    listen 80;
    server_name _;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /api/chat/stream is Server-Sent Events (app/api/main.py) - an
        # nginx reverse proxy buffers the upstream response by default,
        # which would turn streaming into one delayed blocking read.
        # Disable it specifically for this proxied location.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
}
