# Database and logs
mlflow.db
*.log
*.stderr.log
*.stdout.log

# Local course reference projects (not part of this project's own code).
reference/

# Routing Accuracy Lab: local Chroma vector store (rebuild with
# routing_lab/scripts/build_index.py; not committed since it's regenerable
# and would otherwise commit raw OpenAI embedding vectors).
routing_lab/.chroma/

# Routing Accuracy Lab: persistent LLM/embedding response cache (see
# routing_lab/app/cache.py) - development cost-control only, not meant to be
# shared/committed.
routing_lab/.llm_cache.db

# Routing Accuracy Lab: ad-hoc MLflow trace export (scripts/export_mlflow_traces.py) -
# a snapshot of whatever was tested locally and in-session, not a
# reproducible artifact like experiments/architecture_comparison_results.json.
routing_lab/experiments/mlflow_trace_export.json

# routing_lab2/: a working copy of routing_lab/ for the feature/routing-lab2
# experiment (see instructions/learnings/routing-lab2-learnings.md) - same
# regenerable local artifacts as routing_lab/ above, same reasons.
routing_lab2/.chroma/
routing_lab2/.llm_cache.db
routing_lab2/experiments/mlflow_trace_export.json

# routing_lab3/: a working copy for the chat-app migration plan (see
# instructions/learnings/routing-lab3-chat-app-plan.md) - same regenerable
# local artifacts as routing_lab/routing_lab2 above, same reasons.
routing_lab3/.chroma/
routing_lab3/.llm_cache.db
routing_lab3/experiments/mlflow_trace_export.json

